{
  "name": "immigration-pathways",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node tests/country-records.mjs && node tests/rule-validator.mjs && node tests/rule-engine.mjs && node tests/matcher.mjs && node tests/unified-profile.mjs && node tests/advertising-config.mjs && node tests/worker-routing.mjs",
    "test:dist": "node tests/built-site.mjs",
    "test:dist:indexable": "EXPECT_INDEXABLE=true node tests/built-site.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:production": "SITE_BUILD_MODE=production SITE_INDEXING_ENABLED=false ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:indexable": "SITE_BUILD_MODE=production SITE_INDEXING_ENABLED=true ASTRO_TELEMETRY_DISABLED=1 astro build",
    "deploy:cloudflare": "npm run build:production && wrangler deploy",
    "deploy:indexable": "npm run build:indexable && wrangler deploy",
    "traffic:cloudflare": "node scripts/cloudflare-report.mjs",
    "traffic:report": "npm run traffic:cloudflare",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  }
}
