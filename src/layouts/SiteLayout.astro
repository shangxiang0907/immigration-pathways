---
import "../styles/global.css";
import { site } from "../../site.config.mjs";
import { isAdvertisingActive } from "../lib/advertising.mjs";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  locale?: "en" | "zh";
  /** Directory-only stubs opt out of indexing and of advertising. */
  indexable?: boolean;
}

const { title, description, currentPath = Astro.url.pathname, locale = "en", indexable = true } = Astro.props;
const localeConfig = site.locales[locale];
const alternateLocale = locale === "en" ? "zh" : "en";
const alternateConfig = site.locales[alternateLocale];
const pathWithoutLocale = currentPath.replace(/^\/zh(?=\/|$)/, "") || "/";
const alternatePath = alternateLocale === "zh"
  ? `/zh${pathWithoutLocale === "/" ? "/" : pathWithoutLocale}`
  : pathWithoutLocale;
const showLocaleSwitch = currentPath !== "/404";
const isProduction = import.meta.env.SITE_BUILD_MODE === "production";
const indexingEnabled = import.meta.env.SITE_INDEXING_ENABLED === "true";
const hasIndexableContent = indexable && currentPath !== "/404";
const isIndexable = isProduction && indexingEnabled && hasIndexableContent;
// AdSense forbids ads on pages without publisher content, so the loader is
// emitted only where an ad unit may legitimately appear.
const advertisingActive = isAdvertisingActive(site.advertising, isProduction) && hasIndexableContent;
const canonicalUrl = isProduction && currentPath !== "/404" && Astro.site ? new URL(currentPath, Astro.site) : undefined;
const alternateUrl = isProduction && currentPath !== "/404" && Astro.site ? new URL(alternatePath, Astro.site) : undefined;
const defaultPath = locale === "en" ? currentPath : pathWithoutLocale;
const defaultUrl = isProduction && currentPath !== "/404" && Astro.site ? new URL(defaultPath, Astro.site) : undefined;
---

<!doctype html>
<html lang={localeConfig.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={isIndexable ? "index, follow" : "noindex, nofollow, noarchive"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <link rel="alternate" hreflang={localeConfig.htmlLang} href={canonicalUrl} />}
    {alternateUrl && <link rel="alternate" hreflang={alternateConfig.htmlLang} href={alternateUrl} />}
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <meta name="generator" content={Astro.generator} />
    {advertisingActive && <script is:inline async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.advertising.publisherId}`}></script>}
    <title>{title}</title>
  </head>
  <body data-detect-locale={locale === "en" && currentPath === "/" ? "true" : "false"}>
    <a class="skip-link" href="#main-content">{locale === "zh" ? "跳到正文" : "Skip to content"}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={`${localeConfig.pathPrefix}/`}>{site.name}</a>
        <nav aria-label={locale === "zh" ? "主导航" : "Primary navigation"}>
          <ul>
            {localeConfig.navigation.map((link) => (
              <li><a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a></li>
            ))}
            {showLocaleSwitch && <li><a href={alternatePath} data-locale-choice={alternateLocale}>{alternateConfig.label}</a></li>}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class="shell"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <nav aria-label={locale === "zh" ? "联系与法律信息" : "Contact and legal information"}>
          <a href={`${localeConfig.pathPrefix}/contact`}>{locale === "zh" ? "联系" : "Contact"}</a>
          <a href={`${localeConfig.pathPrefix}/privacy`}>{locale === "zh" ? "隐私" : "Privacy"}</a>
          <a href={`${localeConfig.pathPrefix}/terms`}>{locale === "zh" ? "条款" : "Terms"}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  (() => {
    const choiceLinks = document.querySelectorAll("[data-locale-choice]");
    for (const link of choiceLinks) {
      link.addEventListener("click", () => localStorage.setItem("preferred-locale", link.dataset.localeChoice));
    }

    if (document.body.dataset.detectLocale !== "true") return;

    let preferredLocale;
    try {
      preferredLocale = localStorage.getItem("preferred-locale");
    } catch {}

    if (preferredLocale === "en") return;
    const primaryLanguage = navigator.languages?.[0] ?? navigator.language ?? "";
    if (preferredLocale !== "zh" && !primaryLanguage.toLowerCase().startsWith("zh")) return;
    location.replace(`/zh/${location.search}${location.hash}`);
  })();
</script>
