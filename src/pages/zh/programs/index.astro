---
import { getCollection } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { site } from "../../../../site.config.mjs";
const programs = (await getCollection("programs")).sort((a, b) => a.data.name.localeCompare(b.data.name, "zh-CN"));
const countries = await getCollection("countries");
const countryNames = Object.fromEntries(countries.map((country) => [country.id, country.data.name]));
---
<SiteLayout locale="zh" title={`移民项目 — ${site.name}`} description="查询附有官方来源和标准化资格字段的移民项目概览。"><header class="page-heading"><p class="eyebrow">Immigration programs</p><h1>移民项目</h1><p class="lede">这里提供依据政府来源复核的项目概览，帮助你理解主要条件；行动前仍须向主管机构确认每项最新要求。</p></header><section class="directory-tools" aria-labelledby="program-heading"><h2 id="program-heading">现有项目</h2><p class="result-count">{programs.length} 个已复核项目概览</p><div class="card-grid directory-grid">{programs.map((program) => <article class="card"><div class="card-meta"><span class="status status-overview">概览</span><span>{countryNames[program.data.countryId]}</span></div><h2><a href={`/zh/programs/${program.id}`}>{program.data.name}</a></h2><p>{program.data.summary}</p></article>)}</div></section></SiteLayout>
