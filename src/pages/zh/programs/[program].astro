---
import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { site } from "../../../../site.config.mjs";
export async function getStaticPaths() { const programs = await getCollection("programs"); const countries = await getCollection("countries"); return programs.map((program) => ({ params: { program: program.id }, props: { program, country: countries.find((country) => country.id === program.data.countryId)! } })); }
interface Props { program: CollectionEntry<"programs">; country: CollectionEntry<"countries">; }
const { program, country } = Astro.props;
const labels: Record<string, string> = { workExperience: "工作经验", language: "语言", education: "学历", jobOffer: "工作邀请", jobOfferOrCertificate: "工作邀请或技工资格证书", settlementFunds: "安家资金", age: "年龄", occupation: "合资格职业", skillsAssessment: "职业评估", points: "积分测试", english: "英语", nomination: "提名", nominationOrSponsor: "提名或担保", regionalResidence: "偏远地区居住要求", invitation: "申请邀请", qualification: "资格", salary: "薪资", ageSalaryCondition: "年龄相关薪资条件", qualificationRoute: "资格路线", livelihood: "生活资金" };
const statuses = { required: "必须", "not-required": "非必须", conditional: "有条件要求", unknown: "尚未确认" };
const format = new Intl.DateTimeFormat("zh-CN", { dateStyle: "long", timeZone: "UTC" });
---
<SiteLayout locale="zh" title={`${program.data.name} — ${site.name}`} description={program.data.summary}>
  <article class="prose country-detail"><nav class="breadcrumbs" aria-label="面包屑导航"><a href="/zh/programs">移民项目</a><span aria-hidden="true">/</span><span>{program.data.name}</span></nav><p class="eyebrow">{country.data.name}</p><h1>{program.data.name}</h1><div class="card-meta"><span class="status status-overview">政策概览</span><span>复核于 {format.format(program.data.reviewedAt)}</span></div><p class="lede">{program.data.summary}</p><aside class="notice"><h2>使用本概览前请注意</h2><p>以下内容是项目最低条件，不是获批预测。满足最低条件并不保证获得提名、邀请或批准。</p></aside><section><h2>核心条件</h2><div class="requirement-list">{Object.entries(program.data.requirements).map(([key, requirement]) => <article class="requirement"><div class="card-meta"><strong>{labels[key] ?? key}</strong><span class={`requirement-status requirement-${requirement.status}`}>{statuses[requirement.status]}</span></div><p>{requirement.summary}</p></article>)}</div></section><section><h2>官方来源</h2><ul class="source-list">{program.data.sources.map((source) => <li><a href={source.url} rel="external noreferrer">{source.title}</a><span>{source.authority} · 复核于 {format.format(source.reviewedAt)}</span></li>)}</ul></section><p class="disclaimer">本页仅提供一般教育信息，不构成个性化移民或法律建议。要求可能变化，行动前请向负责该项目的政府机构确认。下次计划复核：{format.format(program.data.nextReviewAt)}。</p></article>
</SiteLayout>
