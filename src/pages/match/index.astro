---
import SiteLayout from "../../layouts/SiteLayout.astro"; import { site } from "../../../site.config.mjs";
const options=[{href:"/match/canada",name:"Canada",detail:"Express Entry federal economic programs"},{href:"/match/australia",name:"Australia",detail:"Skilled visa subclasses 189, 190 and 491"},{href:"/match/germany",name:"Germany",detail:"EU Blue Card, qualified-professional visa and opportunity card"}];
---
<SiteLayout title={`Check immigration options — ${site.name}`} description="Choose a country and compare your answers with reviewed program minimums."><header class="page-heading"><p class="eyebrow">Rule-based pre-screen</p><h1>Check your options</h1><p class="lede">Choose a country. Results identify possible matches, barriers and missing information—not approval odds.</p></header><section class="card-grid" aria-label="Available country pre-screens">{options.map(option=><article class="card"><p class="step">3 reviewed pathways</p><h2><a href={option.href}>{option.name}</a></h2><p>{option.detail}</p></article>)}</section><p class="disclaimer">Answers stay in your browser. Coverage is limited to the programs shown.</p></SiteLayout>
