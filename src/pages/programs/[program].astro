---
import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../../site.config.mjs";
import AdSlot from "../../components/AdSlot.astro";
export async function getStaticPaths() { const programs = await getCollection("programs"); const countries = await getCollection("countries"); return programs.map((program) => ({ params: { program: program.id }, props: { program, country: countries.find((country) => country.id === program.data.countryId)! } })); }
interface Props { program: CollectionEntry<"programs">; country: CollectionEntry<"countries">; }
const { program, country } = Astro.props;
const labels: Record<string, string> = { workExperience: "Work experience", language: "Language", education: "Education", jobOffer: "Job offer", jobOfferOrCertificate: "Job offer or trade certificate", settlementFunds: "Settlement funds", age: "Age", field: "Eligible field", endorsementOrPrize: "Endorsement or eligible prize", sponsorship: "Sponsorship", occupation: "Eligible occupation", skillsAssessment: "Skills assessment", points: "Points test", english: "English", nomination: "Nomination", nominationOrSponsor: "Nomination or sponsorship", regionalResidence: "Regional residence", invitation: "Invitation", qualification: "Qualification", salary: "Salary", ageSalaryCondition: "Age-related salary condition", qualificationRoute: "Qualification route", livelihood: "Financial support" };
const statuses = { required: "Required", "not-required": "Not required", conditional: "Conditional", unknown: "Not confirmed" };
Object.assign(labels, { labourMarket: "Labour-market test", visa: "Residence visa", general: "General requirements", activity: "Qualifying activity" });
---
<SiteLayout title={`${program.data.nameEn} — ${site.name}`} description={program.data.summaryEn}>
  <article class="prose country-detail"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/programs">Programs</a><span aria-hidden="true">/</span><span>{program.data.nameEn}</span></nav><p class="eyebrow">{country.data.nameEn}</p><h1>{program.data.nameEn}</h1><div class="card-meta"><span class="status status-overview">Policy overview</span><span>Reviewed {program.data.reviewedAt.toISOString().slice(0, 10)}</span></div><p class="lede">{program.data.summaryEn}</p><aside class="notice"><h2>Before you rely on this overview</h2><p>These are program minimums, not an approval prediction. Meeting minimum requirements does not guarantee nomination, an invitation, or approval.</p></aside><section><h2>Core requirements</h2><div class="requirement-list">{Object.entries(program.data.requirements).map(([key, requirement]) => <article class="requirement"><div class="card-meta"><strong>{labels[key] ?? key}</strong><span class={`requirement-status requirement-${requirement.status}`}>{statuses[requirement.status]}</span></div><p>{requirement.summaryEn}</p></article>)}</div></section><section><h2>Official sources</h2><ul class="source-list">{program.data.sources.map((source) => <li><a href={source.url} rel="external noreferrer">{source.title}</a><span>{source.authority} · Reviewed {source.reviewedAt.toISOString().slice(0, 10)}</span></li>)}</ul></section><p class="disclaimer">General educational information only, not personalized immigration or legal advice. Requirements can change; confirm them with the responsible government authority before acting. Next scheduled review: {program.data.nextReviewAt.toISOString().slice(0, 10)}.</p></article>
  <AdSlot placement="content" />
</SiteLayout>
