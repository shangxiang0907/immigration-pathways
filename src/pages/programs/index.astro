---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../../site.config.mjs";
---

<SiteLayout title={`Immigration programs — ${site.name}`} description="Browse reviewed immigration programs using normalized fields.">
  <header class="page-heading">
    <p class="eyebrow">Immigration programs</p>
    <h1>Immigration programs</h1>
    <p class="lede">Programs will be added in reviewed batches once official sources, review dates, and structured requirements are complete.</p>
  </header>
  <section class="notice" aria-labelledby="program-status">
    <h2 id="program-status">The first program batch is being prepared</h2>
    <p>Country authority links are available now. Detailed eligibility, fees, timing, and comparison tools will follow after verification.</p>
    <p><a href="/countries">Browse countries</a></p>
  </section>
</SiteLayout>
