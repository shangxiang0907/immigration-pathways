---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../../site.config.mjs";
---

<SiteLayout title={`About — ${site.name}`} description={`How ${site.name} selects, verifies, and updates immigration information.`}>
  <article class="prose">
    <p class="eyebrow">About</p>
    <h1>Understand first. Decide second.</h1><p>{site.description}</p>
    <h2>Editorial method</h2><p>Information is organized by country, program, requirement, and source. Eligibility, fees, quotas, processing rules, and deadlines must be checked against the responsible government authority and carry a review date.</p>
    <h2>Coverage status</h2><p>“Directory” means only that an official government entry point has been identified. Overview and deep coverage labels appear only after the corresponding information has been reviewed.</p>
    <h2>Limits</h2><p>This site provides general education, not personalized legal advice or approval predictions. Immigration rules can change; always recheck the listed government sources before acting.</p>
  </article>
</SiteLayout>
