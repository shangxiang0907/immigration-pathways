---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../../site.config.mjs";
---

<SiteLayout title={`Terms — ${site.name}`} description={`Terms for the ${site.name} preview.`}>
  <article class="prose"><p class="eyebrow">Terms</p><h1>Terms of use</h1><p>Content is provided for general education and information only. It is not personalized immigration or legal advice and does not guarantee an application outcome.</p><p>Immigration rules can change at any time. Check the listed government sources and consult a suitably qualified professional when needed.</p><p>These terms describe a preview without accounts, payments, or report services and require further review before publication.</p></article>
</SiteLayout>
