---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../../site.config.mjs";
Astro.response.status = 404;
---

<SiteLayout title={`页面未找到 — ${site.name}`} description="找不到请求的页面。" currentPath="/404">
  <article class="prose"><p class="eyebrow">404</p><h1>页面未找到</h1><p>页面地址可能已经改变。返回<a href="/">首页</a>或查看<a href="/countries">国家目录</a>。</p></article>
</SiteLayout>
