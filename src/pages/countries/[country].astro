---
import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../../site.config.mjs";
import AdSlot from "../../components/AdSlot.astro";

export async function getStaticPaths() {
  const countries = await getCollection("countries");
  const programs = await getCollection("programs");
  return countries.map((country) => ({ params: { country: country.id }, props: { country, programs: programs.filter((program) => program.data.countryId === country.id) } }));
}

interface Props {
  country: CollectionEntry<"countries">;
  programs: CollectionEntry<"programs">[];
}

const { country, programs } = Astro.props;
// Directory records only point at a government portal. They carry no reviewed
// content of our own, so they stay out of the index and out of advertising.
const hasReviewedContent = country.data.coverage !== "directory";
const coverageLabels = {
  directory: "Official directory",
  overview: "Policy overview",
  deep: "Deep coverage",
};
---

<SiteLayout title={`${country.data.nameEn} immigration information — ${site.name}`} description={country.data.summaryEn} indexable={hasReviewedContent}>
  <article class="prose country-detail">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/countries">Countries</a><span aria-hidden="true">/</span><span>{country.data.nameEn}</span></nav>
    <p class="eyebrow">{country.data.name}</p>
    <h1>{country.data.nameEn}</h1>
    <div class="card-meta">
      <span class={`status status-${country.data.coverage}`}>{coverageLabels[country.data.coverage]}</span>
      <span>Reviewed {country.data.reviewedAt.toISOString().slice(0, 10)}</span>
    </div>
    <p class="lede">{country.data.summaryEn}</p>

    {country.data.coverage === "directory" && (
      <aside class="notice" aria-labelledby="coverage-notice">
        <h2 id="coverage-notice">Official entry point only</h2>
        <p>Eligibility, fees, timing, and process details have not yet been reviewed. Consult the government source below and do not treat this page as an eligibility decision.</p>
      </aside>
    )}

    {programs.length > 0 && <section aria-labelledby="programs-heading"><h2 id="programs-heading">Reviewed programs</h2><ul>{programs.map((program) => <li><a href={`/programs/${program.id}`}>{program.data.nameEn}</a> — {program.data.summaryEn}</li>)}</ul></section>}
    {hasReviewedContent && <AdSlot placement="content" />}

    <section aria-labelledby="sources-heading">
      <h2 id="sources-heading">Official sources</h2>
      <ul class="source-list">
        {country.data.sources.map((source) => (
          <li>
            <a href={source.url} rel="external noreferrer">{source.title}</a>
            <span>{source.authority} · Reviewed {source.reviewedAt.toISOString().slice(0, 10)}</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="disclaimer">This page provides general educational information, not personalized immigration or legal advice. Confirm current requirements with the responsible government authority before acting.</p>
  </article>
</SiteLayout>
