---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../../site.config.mjs";

const countries = (await getCollection("countries")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "zh-CN"),
);

const coverageLabels = {
  directory: "Official directory",
  overview: "Policy overview",
  deep: "Deep coverage",
};
---

<SiteLayout title={`Countries — ${site.name}`} description="Find immigration authorities, official entry points, and current coverage by country.">
  <header class="page-heading">
    <p class="eyebrow">Country directory</p>
    <h1>Countries</h1>
    <p class="lede">Start with the official source. Policy summaries, eligibility details, and comparisons appear only after review.</p>
  </header>

  <section class="directory-tools" aria-labelledby="directory-heading">
    <h2 id="directory-heading">Find a country</h2>
    <div class="filter-bar">
      <label>
        <span>Search</span>
        <input id="country-search" type="search" placeholder="Enter a country name" autocomplete="off" />
      </label>
      <label>
        <span>Region</span>
        <select id="region-filter">
          <option value="">All regions</option>
          <option value="Africa">Africa</option><option value="Americas">Americas</option><option value="Asia">Asia</option><option value="Europe">Europe</option><option value="Oceania">Oceania</option>
        </select>
      </label>
    </div>
    <p id="country-count" class="result-count" aria-live="polite">{countries.length} country entries</p>
    <div id="country-grid" class="card-grid directory-grid">
      {countries.map((country) => (
        <article
          class="card country-card"
          data-country-card
          data-search={`${country.data.nameEn} ${country.data.name}`.toLowerCase()}
          data-region={country.data.region}
        >
          <div class="card-meta">
            <span class={`status status-${country.data.coverage}`}>{coverageLabels[country.data.coverage]}</span>
            <span>{country.data.region}</span>
          </div>
          <h2><a href={`/countries/${country.id}`}>{country.data.nameEn}</a></h2>
          <p class="muted">{country.data.name}</p>
          <p>{country.data.summaryEn}</p>
        </article>
      ))}
    </div>
    <p id="country-empty" class="empty-state" hidden>No countries match these filters.</p>
  </section>
</SiteLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#country-search");
  const region = document.querySelector<HTMLSelectElement>("#region-filter");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-country-card]")];
  const count = document.querySelector<HTMLElement>("#country-count");
  const empty = document.querySelector<HTMLElement>("#country-empty");

  const update = () => {
    const query = search?.value.trim().toLowerCase() ?? "";
    const selectedRegion = region?.value ?? "";
    let visible = 0;

    for (const card of cards) {
      const matchesQuery = !query || card.dataset.search?.includes(query);
      const matchesRegion = !selectedRegion || card.dataset.region === selectedRegion;
      card.hidden = !(matchesQuery && matchesRegion);
      if (!card.hidden) visible += 1;
    }

    if (count) count.textContent = `${visible} country entries`;
    if (empty) empty.hidden = visible !== 0;
  };

  search?.addEventListener("input", update);
  region?.addEventListener("change", update);
</script>
