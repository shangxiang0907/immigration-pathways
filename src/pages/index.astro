---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../../site.config.mjs";
---

<SiteLayout title={`${site.name} — Practical guidance`} description={site.description}>
  <section class="hero">
    <p class="eyebrow">Independent knowledge, clearly explained</p>
    <h1>{site.name}</h1>
    <p class="lede">{site.description}</p>
  </section>
  <section aria-labelledby="start-heading">
    <h2 id="start-heading">Start here</h2>
    <div class="card-grid">
      <article class="card"><h2>Understand the topic</h2><p>Replace this card with a focused introduction for the site's real audience.</p></article>
      <article class="card"><h2>Choose a path</h2><p>Turn the approved information architecture into useful, distinct page journeys.</p></article>
      <article class="card"><h2>Verify the details</h2><p>Support material claims with current sources and keep uncertainty visible.</p></article>
    </div>
  </section>
</SiteLayout>
