---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../../site.config.mjs";
---

<SiteLayout title={`Privacy — ${site.name}`} description={`Current data-handling information for ${site.name}.`}>
  <article class="prose"><p class="eyebrow">Privacy</p><h1>Privacy</h1><p>This preview does not use analytics, advertising, accounts, payments, form submissions, or embedded third-party media.</p><p>The country pre-screen tools process answers locally in your browser. They do not transmit or store those answers, and they disappear when you refresh or leave the page.</p><p>Before adding server-generated reports, email, or payments, this page will explain what data is collected, why, how long it is retained, and how it can be deleted.</p><p>This is a practical description of the current preview, not legal advice.</p></article>
</SiteLayout>
