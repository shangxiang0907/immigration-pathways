---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../../site.config.mjs";
---

<SiteLayout title={`Contact — ${site.name}`} description={`Contact information for ${site.name}.`}>
  <article class="prose"><p class="eyebrow">Contact</p><h1>Contact us</h1><p>A public contact method is not yet enabled. A corrections and general-support channel will be added before publication.</p><p>Do not send passports, identity documents, financial records, or other sensitive information through an unconfirmed channel.</p></article>
</SiteLayout>
