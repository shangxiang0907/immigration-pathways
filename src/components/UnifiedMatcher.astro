---
interface Props { locale?: "en" | "zh" } const { locale="en" }=Astro.props; const zh=locale==="zh"; const prefix=zh?"/zh":"";
const t=zh?{title:"一次填写，比较多个国家",intro:"回答 8 个通用问题，查看哪些已收录国家值得优先研究。国家特殊条件会明确标为待确认。",select:"请选择",questions:["你的年龄范围？","你的最高学历？","你的相关工作经验？","你是否至少达到相当于 Competent English 的水平？","你目前有哪个国家的工作邀请？","如项目要求，你能否提供足够资金证明？","你是否愿意在偏远或非核心地区生活？","你的主要目标？"],options:[["unknown","不确定"],["under45","未满 45 岁"],["45plus","45 岁或以上"]],education:[["unknown","不确定"],["secondary","高中或以下"],["postsecondary","大专、职业培训或大学学历"]],experience:[["unknown","不确定"],["lt1","少于 1 年"],["one","1 至 2 年"],["twoPlus","2 年或以上"]],answers:[["unknown","不确定"],["yes","是"],["no","否"]],offers:[["unknown","不确定"],["none","没有"],["canada","加拿大"],["germany","德国"],["other","其他国家"]],goals:[["work","工作"],["permanent","长期居留"],["study","学习"],["explore","先了解选项"]],save:"在此设备保存我的答案",privacy:"默认不保存或上传。勾选后仅写入此浏览器，你可随时清除。",submit:"比较国家",clear:"清除已保存资料",results:"初步比较",possible:"存在无已知障碍的路径",barrier:"当前答案显示已知障碍",missing:"项国家特殊条件仍待确认",review:"查看国家与官方来源",note:"这是基于有限通用信息的教育性初筛，不是资格或法律意见。"}:{title:"Fill once, compare countries",intro:"Answer 8 shared questions to see which covered countries may be worth researching first. Country-specific requirements remain clearly marked for confirmation.",select:"Select one",questions:["What is your age range?","What is your highest education level?","How much relevant work experience do you have?","Do you have at least Competent English or an equivalent level?","Where do you currently have a job offer?","If required, can you show sufficient funds?","Would you live in a regional or non-core area?","What is your main goal?"],options:[["unknown","Not sure"],["under45","Under 45"],["45plus","45 or older"]],education:[["unknown","Not sure"],["secondary","Secondary or below"],["postsecondary","College, vocational training or university"]],experience:[["unknown","Not sure"],["lt1","Less than 1 year"],["one","1 to 2 years"],["twoPlus","2 years or more"]],answers:[["unknown","Not sure"],["yes","Yes"],["no","No"]],offers:[["unknown","Not sure"],["none","None"],["canada","Canada"],["germany","Germany"],["other","Another country"]],goals:[["work","Work"],["permanent","Long-term residence"],["study","Study"],["explore","Explore options"]],save:"Save my answers on this device",privacy:"Nothing is saved or uploaded by default. If selected, answers stay only in this browser and can be cleared anytime.",submit:"Compare countries",clear:"Clear saved profile",results:"Preliminary comparison",possible:"Has a pathway with no known barrier",barrier:"Known barriers appear in current answers",missing:"country-specific items still need confirmation",review:"Review country and official sources",note:"This educational pre-screen uses limited shared information. It is not an eligibility decision or legal advice."};
t.questions[7]=zh?"你的学历或职业资格是否已针对目标国家完成正式评估或认可？":"Have your education or occupational credentials been formally assessed or recognized for the destination?";
t.offers.splice(4,0,["new-zealand",zh?"新西兰":"New Zealand"]);
t.offers.splice(5,0,["united-kingdom",zh?"英国":"United Kingdom"]);
const fields=["age","education","experience","english","jobOffer","funds","regional","qualification"]; const optionSets=[t.options,t.education,t.experience,t.answers,t.offers,t.answers,t.answers,t.answers];
---
<header class="page-heading"><p class="eyebrow">{zh?"轻量跨国预筛":"Lightweight cross-country screen"}</p><h1>{t.title}</h1><p class="lede">{t.intro}</p></header>
<form id="unified-matcher" class="matcher" data-locale={locale} data-prefix={prefix}>{fields.map((field,i)=><label class="question"><span><b>{i+1}.</b> {t.questions[i]}</span><select name={field} required><option value="">{t.select}</option>{optionSets[i].map(([v,l])=><option value={v}>{l}</option>)}</select></label>)}<label><input name="saveProfile" type="checkbox" /> {t.save}</label><p class="matcher-privacy">{t.privacy}</p><div class="hero-actions"><button class="button" type="submit">{t.submit}</button><button id="clear-profile" class="text-button" type="button">{t.clear}</button></div></form>
<section id="unified-results" class="matcher-results" aria-labelledby="unified-results-heading" aria-live="polite" hidden><h2 id="unified-results-heading">{t.results}</h2><div class="result-list"></div><p class="disclaimer">{t.note}</p></section>
<script>
import { matchingRuleSets } from "../data/matching/index.mjs";
import { rankCountries } from "../lib/unified-profile.mjs";
const form=document.querySelector<HTMLFormElement>("#unified-matcher"),section=document.querySelector<HTMLElement>("#unified-results"),list=section?.querySelector<HTMLElement>(".result-list"),clear=document.querySelector<HTMLButtonElement>("#clear-profile");
const key="immigration-pathways-profile-v2",legacyKey="immigration-pathways-profile-v1"; const names={en:{australia:"Australia",canada:"Canada",germany:"Germany","new-zealand":"New Zealand","united-kingdom":"United Kingdom"},zh:{australia:"澳大利亚",canada:"加拿大",germany:"德国","new-zealand":"新西兰","united-kingdom":"英国"}};
const copy={en:{possible:"No decisive barrier found yet",barrier:"Known barriers appear in current answers",paths:"reviewed pathways remain open for research",missing:"country-specific items still need confirmation",known:"Known issue:",review:"Review closest pathway"},zh:{possible:"暂未发现决定性障碍",barrier:"当前答案显示已知障碍",paths:"条已审核路径仍值得继续研究",missing:"项国家特殊条件仍待确认",known:"已知问题：",review:"查看最接近的路径"}};
const barrierText={en:{age:"The stated age range exceeds this pathway's limit.",assessment:"A required credential or skills assessment is not in place.",qualification:"Required qualification recognition is not in place.",english:"The stated English level is below this pathway's minimum.",job:"This pathway requires a qualifying job offer.",funds:"This pathway requires evidence of sufficient funds.",year1:"At least one year of relevant experience is required.",year2:"At least two years of relevant experience is required."},zh:{age:"所填年龄范围超过该路径限制。",assessment:"尚未完成所需资质或职业评估。",qualification:"尚未完成所需资格认可。",english:"所填英语水平低于该路径最低要求。",job:"该路径要求合格工作邀请。",funds:"该路径要求足够资金证明。",year1:"需要至少一年相关经验。",year2:"需要至少两年相关经验。"}};
const scrollBehavior=matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth";
try{const saved=JSON.parse(localStorage.getItem(key)??"null");if(saved?.version===2&&form){for(const el of form.querySelectorAll<HTMLSelectElement>("select"))if(saved.profile[el.name])el.value=saved.profile[el.name];const box=form.elements.namedItem("saveProfile")as HTMLInputElement|null;if(box)box.checked=true;}}catch{}
form?.addEventListener("submit",e=>{e.preventDefault();if(!form.reportValidity()||!section||!list)return;const raw=Object.fromEntries(new FormData(form).entries());const profile=Object.fromEntries(Object.entries(raw).filter(([k])=>k!=="saveProfile"));if(raw.saveProfile)localStorage.setItem(key,JSON.stringify({version:2,profile}));else localStorage.removeItem(key);const locale=form.dataset.locale==="zh"?"zh":"en",text=copy[locale],prefix=form.dataset.prefix??"",barriers=barrierText[locale];const rows=rankCountries(profile,matchingRuleSets);list.innerHTML=rows.map((x:{countryId:string;viable:number;total:number;missing:number;bestProgramId?:string;barrierKeys:string[]})=>{const issue=x.barrierKeys.map(key=>barriers[key as keyof typeof barriers]).filter(Boolean)[0];return `<article class="match-result ${x.viable?"match-unknown":"match-fail"}"><span class="match-label">${x.viable?text.possible:text.barrier}</span><h3>${names[locale][x.countryId as keyof typeof names.en]}</h3><p><strong>${x.viable}/${x.total}</strong> ${text.paths} · ${x.missing} ${text.missing}</p>${issue?`<p><strong>${text.known}</strong> ${issue}</p>`:""}<a href="${prefix}/programs/${x.bestProgramId}">${text.review}</a></article>`}).join("");section.hidden=false;section.scrollIntoView({behavior:scrollBehavior});});
clear?.addEventListener("click",()=>{localStorage.removeItem(key);localStorage.removeItem(legacyKey);form?.reset();if(section)section.hidden=true;});
</script>
