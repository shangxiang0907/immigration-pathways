---
interface Props { locale?: "en" | "zh"; }
const { locale = "en" } = Astro.props;
const copy = locale === "zh"
  ? { clear: "撤回广告同意", cleared: "广告同意已撤回。再次遇到广告位时，网站会重新询问。" }
  : { clear: "Withdraw advertising consent", cleared: "Advertising consent was withdrawn. The site will ask again at the next advertising placement." };
---

<div class="consent-settings">
  <button class="button button-secondary" type="button" data-clear-ad-consent data-cleared-message={copy.cleared}>{copy.clear}</button>
  <p class="muted" data-ad-consent-status aria-live="polite"></p>
</div>

<script is:inline>
  (() => {
    const container = document.currentScript?.previousElementSibling;
    const button = container?.querySelector("[data-clear-ad-consent]");
    const status = container?.querySelector("[data-ad-consent-status]");
    button?.addEventListener("click", () => {
      try { localStorage.removeItem("immigration-pathways-ad-consent-v1"); } catch {}
      if (status) status.textContent = button.dataset.clearedMessage;
    });
  })();
</script>
