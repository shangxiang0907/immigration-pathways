---
interface Props { locale?: "en"|"zh" } const { locale="en" }=Astro.props; const zh=locale==="zh"; const prefix=zh?"/zh":"";
const t=zh?{title:"德国工作与求职路径快速预筛",intro:"回答基础问题，比较欧盟蓝卡、专业技术人员工作签证和求职机会卡。答案仅在浏览器处理。",yes:"是",no:"否",unknown:"不确定",submit:"查看初步结果",reset:"重新填写",questions:["你的学历或职业资格是否已在德国获得认可或可比？","你是否已有德国的具体合格工作邀请？","蓝卡工作邀请期限是否至少六个月？","若年满 45 岁，你是否属于首次赴德国工作？","你是否能证明有足够养老保障？","你是否有在取得国获认可的大学学历或通常至少两年的职业培训资格？","机会卡积分路线是否达到德语 A1 或英语 B2？","机会卡积分路线是否达到至少 6 分？","你能否证明求职期间生活资金充足？","较低蓝卡薪资是否符合紧缺职业、毕业未满三年或合资格 IT 经验路线？"]}:{title:"Germany work and job-search pre-screen",intro:"Compare basic requirements for the EU Blue Card, qualified-professional work visa and opportunity card. Answers stay in your browser.",yes:"Yes",no:"No",unknown:"Not sure",submit:"See preliminary results",reset:"Start again",questions:["Is your academic or vocational qualification recognized or comparable in Germany?","Do you have a specific offer of qualified employment in Germany?","Is the Blue Card job offer for at least six months?","If you are over 45, would this be your first time coming to work in Germany?","Can you demonstrate adequate pension provision?","Do you have a degree recognized in its country of award or generally at least two years of vocational training?","For the opportunity-card points route, do you have German A1 or English B2?","Do you reach at least 6 points for the opportunity-card points route?","Can you prove sufficient funds for the job-search period?","For the lower Blue Card salary, do you qualify through a shortage occupation, a recent qualification within three years, or the eligible IT route?"]};
const fields=["recognized","job","sixMonths","over45First","pension","formalQualification","language","sixPoints","funds","lowerEligible"];
---
<header class="page-heading"><p class="eyebrow">{zh?"透明规则预筛":"Transparent rule-based screening"}</p><h1>{t.title}</h1><p class="lede">{t.intro}</p><p><a href={`${prefix}/match`}>{zh?"查看加拿大":"Check Canada"}</a> · <a href={`${prefix}/match/australia`}>{zh?"查看澳大利亚":"Check Australia"}</a></p></header>
<form id="germany-form" class="matcher" data-locale={locale} data-prefix={prefix}>{t.questions.slice(0,3).map((q,i)=><fieldset class="question"><legend><b>{i+1}.</b> {q}</legend>{[["yes",t.yes],["no",t.no],["unknown",t.unknown]].map(([v,l])=><label><input type="radio" name={fields[i]} value={v} required={v==="yes"}/>{l}</label>)}</fieldset>)}<label class="question"><span><b>4.</b> {zh?"蓝卡工作邀请的 2026 年税前年薪档位？":"What is the 2026 gross annual salary band for the Blue Card offer?"}</span><select name="salary" required><option value="">{zh?"请选择":"Select one"}</option><option value="over45">€55,770+</option><option value="general">€50,700–€55,769</option><option value="lower">€45,934.20–€50,699</option><option value="below">{zh?"低于 €45,934.20":"Below €45,934.20"}</option><option value="unknown">{t.unknown}</option></select></label>{t.questions.slice(3).map((q,i)=><fieldset class="question"><legend><b>{i+5}.</b> {q}</legend>{[["yes",t.yes],["no",t.no],["unknown",t.unknown]].map(([v,l])=><label><input type="radio" name={fields[i+3]} value={v} required={v==="yes"}/>{l}</label>)}</fieldset>)}<p class="matcher-privacy">{zh?"答案不会上传或保存。金额为 2026 年标准，申请时必须重新查验。":"Answers are not uploaded or saved. Amounts are 2026 figures and must be rechecked when applying."}</p><button class="button" type="submit">{t.submit}</button></form>
<section id="germany-results" class="matcher-results" aria-live="polite" hidden><h2>{zh?"初步结果":"Preliminary results"}</h2><div id="germany-result-list" class="result-list"></div><button id="germany-reset" class="text-button" type="button">{t.reset}</button></section>
<script>
import {evaluateGermanyPrograms} from "../lib/germany-matcher.mjs"; import {resultStatus} from "../lib/matcher.mjs";
const form=document.querySelector<HTMLFormElement>("#germany-form"),results=document.querySelector<HTMLElement>("#germany-results"),list=document.querySelector<HTMLElement>("#germany-result-list"),reset=document.querySelector<HTMLButtonElement>("#germany-reset"); const keys=["blue","qualified","opportunity"] as const;
const c={en:{likely:"Potential match",fail:"Does not meet stated minimums",unknown:"More information needed",why:"What affected this result",pass:"No stated minimum barrier found in these answers.",details:"Review pathway",note:"This is not an eligibility decision. Authorities must confirm recognition, role details, salary, evidence and general residence requirements.",names:{blue:"Germany EU Blue Card",qualified:"Work visa for qualified professionals",opportunity:"Job-search opportunity card"}},zh:{likely:"可能匹配",fail:"未达到已列最低条件",unknown:"需要更多信息",why:"影响本结果的因素",pass:"根据这些答案，暂未发现已列最低条件障碍。",details:"查看路径",note:"这不是资格裁定。资格认可、岗位、薪资、证明文件及一般居留条件仍须由主管机构确认。",names:{blue:"德国欧盟蓝卡",qualified:"专业技术人员工作签证",opportunity:"求职机会卡"}}}; const rr={en:{qualification:"German recognition or comparability is required.",job:"A specific qualified job offer is required.",duration:"The Blue Card offer must last at least six months.",salary:"The stated Blue Card salary threshold is not met or unclear.",lowerEligible:"The lower salary needs a qualifying exception and applicable approval.",over45:"First-time workers over 45 need the higher salary or adequate pension provision.",funds:"Sufficient job-search funds are required.",pointsRoute:"Without German recognition, the formal qualification, language and six-point conditions must all be met."},zh:{qualification:"须具备德国认可或可比资格。",job:"须有具体合格工作邀请。",duration:"蓝卡工作邀请须至少六个月。",salary:"蓝卡薪资门槛未达到或尚不确定。",lowerEligible:"较低薪资须符合例外路线及相应审批。",over45:"年满 45 岁首次赴德工作者须达到较高薪资或有足够养老保障。",funds:"须有足够求职生活资金。",pointsRoute:"未获德国完全认可时，须同时满足基础资格、语言和六分条件。"}}; const slugs={blue:"germany-eu-blue-card",qualified:"germany-work-qualified-professionals",opportunity:"germany-opportunity-card"};
form?.addEventListener("submit",e=>{e.preventDefault();if(!form.reportValidity()||!results||!list)return;const lang=form.dataset.locale==="zh"?"zh":"en",text=c[lang],out=evaluateGermanyPrograms(Object.fromEntries(new FormData(form).entries()),rr[lang]),prefix=form.dataset.prefix??"";list.innerHTML=keys.map(k=>{const v=out[k],s=resultStatus(v),items=v.fail.length?v.fail:v.unknown.length?v.unknown:[text.pass];return `<article class="match-result match-${s}"><span class="match-label">${text[s]}</span><h3>${text.names[k]}</h3><h4>${text.why}</h4><ul>${items.map(x=>`<li>${x}</li>`).join("")}</ul><a href="${prefix}/programs/${slugs[k]}">${text.details}</a></article>`}).join("");const n=document.createElement("p");n.className="disclaimer";n.textContent=text.note;list.append(n);results.hidden=false;results.scrollIntoView({behavior:"smooth"});}); reset?.addEventListener("click",()=>{form?.reset();if(results)results.hidden=true;});
</script>
