---
import { questionnairesByCountry } from "../data/questionnaires/index.mjs";
import { matchingRulesByCountry } from "../data/matching/index.mjs";
interface Props { countryId: keyof typeof questionnairesByCountry; locale?: "en" | "zh"; }
const { countryId, locale = "en" } = Astro.props;
const questionnaire = questionnairesByCountry[countryId];
const text = questionnaire.copy[locale];
const prefix = locale === "zh" ? "/zh" : "";
const formId = `${countryId}-matcher-form`;
const resultsId = `${countryId}-matcher-results`;
const configId = `${countryId}-matcher-config`;
const clientConfig = JSON.stringify({ questionnaire, rules: matchingRulesByCountry[countryId] }).replaceAll("<", "\\u003c");
---
<header class="page-heading">
  <p class="eyebrow">{text.eyebrow}</p><h1>{text.title}</h1><p class="lede">{text.intro}</p>
  <p><a href={`${prefix}/match`}>{locale === "zh" ? "查看其他国家" : "Check another country"}</a></p>
</header>
<form id={formId} class="matcher" data-country={countryId} data-config={configId} data-locale={locale} data-prefix={prefix}>
  {questionnaire.questions.map((question, index) => <fieldset class="question"><legend><b>{index + 1}.</b> {question.label[locale]}</legend><label><input type="radio" name={question.field} value="yes" required /> {text.yes}</label><label><input type="radio" name={question.field} value="no" /> {text.no}</label><label><input type="radio" name={question.field} value="unknown" /> {text.unknown}</label></fieldset>)}
  <p class="matcher-privacy">{text.privacy}</p><button class="button" type="submit">{text.submit}</button>
</form>
<section id={resultsId} class="matcher-results" aria-live="polite" hidden><h2>{text.results}</h2><div class="result-list"></div><button class="text-button" type="button">{text.reset}</button></section>
<script is:inline id={configId} type="application/json" set:html={clientConfig}></script>
<script>
  import { evaluateProgramRules } from "../lib/rule-engine.mjs";
  import { resultStatus } from "../lib/matcher.mjs";
  document.querySelectorAll<HTMLFormElement>("form[data-country]").forEach((form) => {
    if (form.dataset.bound === "true") return; form.dataset.bound = "true";
    const countryId = form.dataset.country ?? "";
    const locale = form.dataset.locale === "zh" ? "zh" : "en";
    const configNode = document.getElementById(form.dataset.config ?? "");
    if (!configNode?.textContent) return;
    const { questionnaire, rules } = JSON.parse(configNode.textContent);
    const results = document.querySelector<HTMLElement>(`#${countryId}-matcher-results`); const list = results?.querySelector<HTMLElement>(".result-list"); const reset = results?.querySelector<HTMLButtonElement>(".text-button");
    form.addEventListener("submit", (event) => { event.preventDefault(); if (!form.reportValidity() || !results || !list) return;
      const text = questionnaire.copy[locale]; const evaluated = evaluateProgramRules(Object.fromEntries(new FormData(form).entries()), rules.programs, questionnaire.reasons[locale]); const prefix = form.dataset.prefix ?? "";
      list.innerHTML = Object.entries(evaluated).map(([key, rawValue]) => { const value = rawValue as { fail: string[]; unknown: string[] }; const status = resultStatus(value); const label = status === "unknown" ? text.more : text[status]; const items: string[] = value.fail.length ? value.fail : value.unknown.length ? value.unknown : [text.pass]; const program = questionnaire.programs[key]; return `<article class="match-result match-${status}"><span class="match-label">${label}</span><h3>${program.name[locale]}</h3><h4>${text.reasons}</h4><ul>${items.map((item) => `<li>${item}</li>`).join("")}</ul><a href="${prefix}/programs/${program.slug}">${text.details}</a></article>`; }).join("");
      const note = document.createElement("p"); note.className = "disclaimer"; note.textContent = text.disclaimer; list.append(note); results.hidden = false; results.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    reset?.addEventListener("click", () => { form.reset(); if (results) results.hidden = true; form.scrollIntoView({ behavior: "smooth" }); });
  });
</script>
