---
interface Props { locale?: "en" | "zh"; }
const { locale = "en" } = Astro.props; const zh = locale === "zh"; const prefix = zh ? "/zh" : "";
const t = zh ? {
  eyebrow:"透明规则预筛", title:"澳大利亚技术签证快速预筛", intro:"回答 8 个问题，初步比较 189、190 和 491 三类签证的基础门槛。答案只在浏览器中处理，不会上传或保存。", yes:"是", no:"否", unknown:"不确定", submit:"查看初步结果", results:"初步结果", reset:"重新填写",
  questions:["收到申请邀请时，你是否会未满 45 岁？","你的提名职业是否在目标签证适用的技术职业清单上？","你是否持有该提名职业的有效合格职业评估？","你的 SkillSelect 估算积分是否至少为 65 分？","你是否至少达到 Competent English？","你是否已获得州或领地政府提名？","你是否有符合 491 条件、通常居住在指定偏远地区的合资格亲属担保？","你和同行家属是否愿意在指定偏远地区生活、工作和学习？"],
} : {
  eyebrow:"Transparent rule-based screening", title:"Australia skilled visa quick pre-screen", intro:"Answer 8 questions to compare basic requirements for subclasses 189, 190 and 491. Answers stay in your browser and are not uploaded or saved.", yes:"Yes", no:"No", unknown:"Not sure", submit:"See preliminary results", results:"Preliminary results", reset:"Start again",
  questions:["Will you be under 45 when invited to apply?","Is your nominated occupation on the relevant skilled occupation list?","Do you hold a suitable, valid skills assessment for that occupation?","Is your estimated SkillSelect points score at least 65?","Do you have at least Competent English?","Have you received state or territory government nomination?","Do you have an eligible relative sponsor usually resident in a designated regional area for subclass 491?","Are you and accompanying family willing to live, work and study in designated regional Australia?"],
};
const fields = ["under45","occupation","assessment","points","english","stateNomination","relativeSponsor","regional"];
---
<header class="page-heading"><p class="eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p class="lede">{t.intro}</p><p><a href={`${prefix}/match`}>{zh ? "改查加拿大" : "Check Canada instead"}</a></p></header>
<form id="australia-form" class="matcher" data-locale={locale} data-prefix={prefix}>{t.questions.map((question, index) => <fieldset class="question"><legend><b>{index + 1}.</b> {question}</legend><label><input type="radio" name={fields[index]} value="yes" required /> {t.yes}</label><label><input type="radio" name={fields[index]} value="no" /> {t.no}</label><label><input type="radio" name={fields[index]} value="unknown" /> {t.unknown}</label></fieldset>)}<p class="matcher-privacy">{zh ? "本工具不会将答案发送到服务器。刷新或离开页面后答案即消失。" : "This tool does not send answers to a server. Answers disappear when you refresh or leave the page."}</p><button class="button" type="submit">{t.submit}</button></form>
<section id="australia-results" class="matcher-results" aria-labelledby="australia-results-heading" aria-live="polite" hidden><h2 id="australia-results-heading">{t.results}</h2><div id="australia-result-list" class="result-list"></div><button id="australia-reset" class="text-button" type="button">{t.reset}</button></section>
<script>
  import { evaluateAustraliaPrograms } from "../lib/australia-matcher.mjs"; import { resultStatus } from "../lib/matcher.mjs";
  const form = document.querySelector<HTMLFormElement>("#australia-form"); const results = document.querySelector<HTMLElement>("#australia-results"); const list = document.querySelector<HTMLElement>("#australia-result-list"); const reset = document.querySelector<HTMLButtonElement>("#australia-reset");
  const copy = { en:{likely:"Potential match",fail:"Does not meet stated minimums",unknown:"More information needed",pass:"No stated minimum barrier found in these answers.",reasons:"What affected this result",details:"Review visa",disclaimer:"This is not an eligibility or invitation decision. Occupation-list fit, assessment validity, points evidence, health, character, nomination criteria and invitation availability still require official confirmation."}, zh:{likely:"可能匹配",fail:"未达到已列最低条件",unknown:"需要更多信息",pass:"根据这些答案，暂未发现已列最低条件障碍。",reasons:"影响本结果的因素",details:"查看签证",disclaimer:"这不是资格或邀请裁定。职业清单适用性、评估有效性、积分证据、健康品行、提名细则及邀请情况仍须向官方确认。"} };
  const reasonText = { en:{age:"You must be under 45 when invited.",occupation:"Your occupation must be on the relevant list.",assessment:"A suitable valid skills assessment is required.",points:"At least 65 points are required; actual invitation scores may be higher.",english:"At least Competent English is required.",nomination:"Subclass 190 requires state or territory nomination.",nominationOrSponsor:"Subclass 491 requires state/territory nomination or eligible-relative sponsorship.",regional:"Subclass 491 requires living, working and studying in designated regional Australia."}, zh:{age:"收到邀请时须未满 45 岁。",occupation:"职业须在对应技术职业清单上。",assessment:"须有有效的合格职业评估。",points:"至少须有 65 分；实际获邀分数可能更高。",english:"至少须达到 Competent English。",nomination:"190 类要求州或领地政府提名。",nominationOrSponsor:"491 类要求州/领地提名或合资格亲属担保。",regional:"491 类要求在指定偏远地区生活、工作和学习。"} };
  const names={en:{visa189:"Skilled Independent visa (subclass 189)",visa190:"Skilled Nominated visa (subclass 190)",visa491:"Skilled Work Regional visa (subclass 491)"},zh:{visa189:"独立技术签证（189 类）",visa190:"州担保技术签证（190 类）",visa491:"偏远地区技术工作签证（491 类）"}}; const slugs={visa189:"australia-skilled-independent-189",visa190:"australia-skilled-nominated-190",visa491:"australia-skilled-work-regional-491"}; const programKeys=["visa189","visa190","visa491"] as const;
  form?.addEventListener("submit",(event)=>{event.preventDefault();if(!form.reportValidity()||!results||!list)return;const locale=form.dataset.locale==="zh"?"zh":"en";const text=copy[locale];const evaluated=evaluateAustraliaPrograms(Object.fromEntries(new FormData(form).entries()),reasonText[locale]);const prefix=form.dataset.prefix??"";list.innerHTML=programKeys.map((key)=>{const value=evaluated[key];const status=resultStatus(value);const items:string[]=value.fail.length?value.fail:value.unknown.length?value.unknown:[text.pass];return `<article class="match-result match-${status}"><span class="match-label">${text[status]}</span><h3>${names[locale][key]}</h3><h4>${text.reasons}</h4><ul>${items.map((item)=>`<li>${item}</li>`).join("")}</ul><a href="${prefix}/programs/${slugs[key]}">${text.details}</a></article>`}).join("");const note=document.createElement("p");note.className="disclaimer";note.textContent=text.disclaimer;list.append(note);results.hidden=false;results.scrollIntoView({behavior:"smooth",block:"start"});});
  reset?.addEventListener("click",()=>{form?.reset();if(results)results.hidden=true;form?.scrollIntoView({behavior:"smooth"});});
</script>
