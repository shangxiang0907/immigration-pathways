# Copy this file to .env.traffic.local. Never commit the local file.

# Reusable read-only token with Zone Analytics and Zone Read permissions.
CLOUDFLARE_API_TOKEN=
# Optional if this project is reused for a different Cloudflare zone.
CLOUDFLARE_ZONE=pathwaystoabroad.com

# AdSense earnings reporting is not wired up yet. It needs the AdSense
# Management API with OAuth rather than a static token, so it stays deferred
# until an AdSense account is approved and activation is authorized.
